@article{Mora_et_al,
  author  = {Bojórquez Mora, Edén and Leyva Madrigal, Herian and Reyes Salazar, Alfredo and Fernández González, Eduardo and Bojórquez Mora, Juan and Leal Graciano, Jesús and Serrano Corona, Juan},
  title   = {Diseño óptimo multi-objetivo de edificios de concreto reforzado usando algoritmos genéticos},
  journal = {\textbf{Revista Ingeniería Sísmica}},
  volume  = {99},
  number  = {—},
  pages   = {23-47},
  year    = {2018},
  doi     = {10.18867/ris.99.484},
  url     = {https://smis.mx/index.php/RIS/article/view/RIS-99-2},
  keywords = {optimización multi-objetivo; algoritmos genéticos; edificios de concreto reforzado; marcos sísmicos},
  abstract = {Se muestra el diseño sísmico óptimo de marcos estructurales de concreto reforzado mediante la aplicación de los algoritmos genéticos multi-objetivo, considerando dos objetivos simultáneos: controlar la distorsión máxima de entrepiso y minimizar el costo total estructural del marco. Para ello se analiza la estructura bajo fuerzas laterales sísmicas y se utiliza el algoritmo evolutivo Non-Dominated Sorting Genetic Algorithm II (NSGA-II). Los resultados muestran que los algoritmos genéticos son una herramienta muy útil para encontrar soluciones de optimización estructural, y que los diseños obtenidos tienen un desempeño sísmico y económico adecuado.} 
}

